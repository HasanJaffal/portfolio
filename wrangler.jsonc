{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Worker that serves hassanjaffal.com — confirmed by the
  // "Workers Builds: portfolio" check Cloudflare posts on every push. Changing
  // it does not rename that Worker: a deploy would create a *second* one under
  // the new name, with no custom domain attached, and report success while the
  // live site kept serving the old build.
  "name": "portfolio",

  "compatibility_date": "2026-09-04",

  // No "main": this is an assets-only Worker. There is no server-side code,
  // just the built site, so Cloudflare serves `dist` directly.
  "assets": {
    "directory": "./dist",

    // The one setting the whole SPA depends on, and the reason this file is
    // tracked rather than left in the dashboard. Workers Assets serves
    // index.html for any path that doesn't match a file on disk, so /projects
    // resolves on a direct hit or a refresh instead of 404ing.
    //
    // Do not replace this with a public/_redirects file. Workers Assets strips
    // /index and .html when matching, so the usual `/*  /index.html  200` rule
    // matches its own target and the deploy is rejected outright with
    // "Infinite loop detected in this rule".
    "not_found_handling": "single-page-application"
  }
}
